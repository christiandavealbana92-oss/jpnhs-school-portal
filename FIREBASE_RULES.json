{
  "rules": {
    ".read": false,
    ".write": false,
    "schools": { "$school": { ".read": true, ".write": "auth != null" } },
    "studentsBySchool": { "$school": { "$student": { ".read": "auth != null", ".write": "auth != null" } } },
    "staff": { "$school": { "$staff": { ".read": "auth != null", ".write": "auth != null" } } },
    "accounts": { "$school": { "$uid": {
      ".read": "auth != null && auth.uid === $uid",
      ".write": "auth != null && auth.uid === $uid"
    } } },
    "accountIndex": { "$school": { "$record": {
      ".read": "auth != null",
      ".write": "auth != null"
    } } },
    "community": { "$school": {
      "posts": { "$post": {
        ".read": true,
        ".write": "auth != null"
      } },
      "notifications": { ".read": "auth != null", ".write": "auth != null" }
    } }
  }
}
